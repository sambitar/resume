---
---

<div class="pharma-hardware-demo">
  <p class="frame-title">Custom ESP32 field endpoint</p>
  <svg class="pharma-hw-svg" viewBox="0 0 360 200" xmlns="http://www.w3.org/2000/svg">
    <rect width="360" height="200" fill="#ecfdf5" />
    <!-- Enclosure -->
    <rect x="120" y="50" width="120" height="90" rx="6" fill="#1e293b" stroke="#0d9488" stroke-width="2" />
    <rect x="130" y="60" width="100" height="50" rx="3" fill="#0f766e" opacity="0.3" />
    <!-- ESP32 board -->
    <rect x="145" y="72" width="70" height="36" rx="2" fill="#334155" stroke="#94a3b8" />
    <text x="180" y="92" text-anchor="middle" fill="#5eead4" font-size="8" font-family="monospace">ESP32</text>
    <circle cx="155" cy="78" r="2" fill="#22c55e" class="sensor-dot s1" />
    <circle cx="215" cy="78" r="2" fill="#22c55e" class="sensor-dot s2" />
    <!-- Antenna -->
    <rect x="175" y="42" width="10" height="12" fill="#64748b" />
    <path d="M180 42 L180 28 L195 20" stroke="#64748b" stroke-width="2" fill="none" />
    <!-- Sensor probe -->
    <line x1="180" y1="140" x2="180" y2="165" stroke="#0d9488" stroke-width="3" />
    <rect x="168" y="165" width="24" height="20" rx="4" fill="#cbd5e1" stroke="#0d9488" stroke-width="1.5" />
    <text x="180" y="178" text-anchor="middle" fill="#0f766e" font-size="7">NTC probe</text>
    <!-- Cable to rack -->
    <path d="M240 95 L300 75" stroke="#94a3b8" stroke-width="2" stroke-dasharray="4 3" />
    <rect x="300" y="55" width="40" height="50" fill="#e2e8f0" stroke="#94a3b8" />
    <text x="320" y="82" text-anchor="middle" font-size="7" fill="#64748b">Rack</text>
    <text x="180" y="28" text-anchor="middle" font-size="9" fill="#0f766e" font-weight="600">IP67 enclosure · PoE optional</text>
  </svg>
  <div class="pharma-hw-labels">
    <span>Calibrated temp probe</span>
    <span>ESP32 + MQTT</span>
    <span>Field commissioning</span>
  </div>
</div>
