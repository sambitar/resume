---
import AppWindow from "../AppWindow.astro";
---

<AppWindow url="app.meridian-pm.io/financials">
  <div class="pm-app-shell">
    <aside class="pm-sidebar">
      <div class="logo"><span class="logo-mark"></span> Meridian</div>
      <span class="pm-nav-item active">Financials</span>
    </aside>
    <div class="pm-main">
      <header class="pm-header">
        <div>
          <h1>Financial control</h1>
          <p class="sub">Approved · Committed · Forecast</p>
        </div>
      </header>
      <div class="pm-kpi-row">
        <div class="pm-kpi"><div class="label">Approved</div><div class="value">$6.5M</div></div>
        <div class="pm-kpi"><div class="label">Spent</div><div class="value">$4.4M</div></div>
        <div class="pm-kpi"><div class="label">Committed</div><div class="value">$1.2M</div></div>
        <div class="pm-kpi"><div class="label">Forecast</div><div class="value">$6.1M</div><span class="pm-pill ok">Under</span></div>
      </div>
      <div class="pm-panel">
        <h2>Cost breakdown by category</h2>
        <table class="pm-table">
          <thead>
            <tr><th>Category</th><th class="num">Budget</th><th class="num">Actual</th><th class="num">Var</th></tr>
          </thead>
          <tbody>
            <tr><td>Labor</td><td class="num">$2.1M</td><td class="num">$1.9M</td><td class="num">−$200K</td></tr>
            <tr><td>Materials</td><td class="num">$2.8M</td><td class="num">$2.0M</td><td class="num">−$800K</td></tr>
            <tr><td>Subcontractors</td><td class="num">$1.2M</td><td class="num">$0.4M</td><td class="num neg">+$50K</td></tr>
            <tr><td>Contingency</td><td class="num">$400K</td><td class="num">$100K</td><td class="num">—</td></tr>
          </tbody>
        </table>
      </div>
      <div class="pm-panel" style="margin-top:0.5rem">
        <h2>Forecast to complete</h2>
        <div class="pm-bars" aria-hidden="true">
          <span style="height:55%"></span><span style="height:70%"></span><span style="height:62%"></span>
          <span style="height:85%"></span><span style="height:78%"></span><span style="height:90%"></span>
        </div>
      </div>
    </div>
  </div>
</AppWindow>
