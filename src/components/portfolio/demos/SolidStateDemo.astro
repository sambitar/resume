<svg class="demo-svg demo-solid-state" viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg">
  <rect width="320" height="200" fill="#0c0f14" />
  <text x="80" y="42" text-anchor="middle" fill="#9aa8bc" font-size="8" font-family="IBM Plex Mono, monospace">BEFORE</text>
  <text x="240" y="42" text-anchor="middle" fill="#9aa8bc" font-size="8" font-family="IBM Plex Mono, monospace">AFTER</text>
  <!-- Relay -->
  <g transform="translate(40, 55)">
    <rect x="0" y="0" width="80" height="100" rx="6" fill="#1a2230" stroke="#2a3548" stroke-width="1.5" />
    <rect x="20" y="20" width="40" height="30" rx="4" fill="#141a24" stroke="#9aa8bc" stroke-width="1" />
    <rect x="28" y="28" width="24" height="14" rx="2" fill="#2a3548" class="relay-arm" />
    <circle cx="40" cy="70" r="8" fill="none" stroke="#9aa8bc" stroke-width="1.5" class="relay-coil" />
    <text x="40" y="92" text-anchor="middle" fill="#9aa8bc" font-size="7" font-family="IBM Plex Mono, monospace">RELAY</text>
  </g>
  <!-- Arrow -->
  <path d="M130 105 L175 105" stroke="#3d9eff" stroke-width="2" class="ss-arrow" />
  <polygon points="175,100 185,105 175,110" fill="#3d9eff" />
  <!-- Solid state -->
  <g transform="translate(200, 55)">
    <rect x="0" y="0" width="80" height="100" rx="6" fill="#1a2230" stroke="#3d9eff" stroke-width="1.5" />
    <rect x="18" y="25" width="44" height="50" rx="4" fill="#141a24" stroke="#3d9eff" stroke-width="1" />
    <rect x="26" y="38" width="28" height="24" rx="2" fill="#2563a8" class="ss-chip" />
    <text x="8" y="18" fill="#3d9eff" font-size="10" font-family="monospace">SS</text>
    <circle cx="40" cy="88" r="4" fill="#3d9eff" class="ss-led" />
    <text x="40" y="92" text-anchor="middle" fill="#3d9eff" font-size="7" font-family="IBM Plex Mono, monospace" dy="8">SOLID STATE</text>
  </g>
</svg>
