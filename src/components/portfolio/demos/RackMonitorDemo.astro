  </g>
  <!-- Alerts -->
  <g transform="translate(168, 148)">
    <rect x="0" y="0" width="56" height="28" rx="4" fill="#1a2230" stroke="#3d9eff" stroke-width="1" class="rack-alert" />
    <text x="28" y="18" text-anchor="middle" fill="#3d9eff" font-size="8" font-family="IBM Plex Mono, monospace">SMS</text>
    <rect x="64" y="0" width="56" height="28" rx="4" fill="#1a2230" stroke="#3d9eff" stroke-width="1" class="rack-alert rack-alert-delay" />
    <text x="92" y="18" text-anchor="middle" fill="#3d9eff" font-size="8" font-family="IBM Plex Mono, monospace">EMAIL</text>
  </g>
