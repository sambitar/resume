<svg class="demo-svg demo-rack" viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg">
  <rect width="320" height="200" fill="#0c0f14" />
  <!-- Rack -->
  <g transform="translate(48, 35)">
    <rect x="0" y="0" width="100" height="130" rx="4" fill="#1a2230" stroke="#2a3548" stroke-width="1.5" />
    <rect x="8" y="12" width="84" height="18" rx="2" fill="#141a24" stroke="#2a3548" />
    <rect x="8" y="36" width="84" height="18" rx="2" fill="#141a24" stroke="#2a3548" />
    <rect x="8" y="60" width="84" height="18" rx="2" fill="#141a24" stroke="#2a3548" />
    <rect x="8" y="84" width="84" height="18" rx="2" fill="#141a24" stroke="#2a3548" />
    <circle cx="20" cy="21" r="3" fill="#3d9eff" class="sensor s1" />
    <circle cx="20" cy="45" r="3" fill="#3d9eff" class="sensor s2" />
    <circle cx="80" cy="69" r="3" fill="#3d9eff" class="sensor s3" />
    <circle cx="80" cy="93" r="3" fill="#3d9eff" class="sensor s4" />
  </g>
  <!-- Chart -->
  <g transform="translate(168, 50)">
    <rect x="0" y="0" width="130" height="90" rx="6" fill="#1a2230" stroke="#2a3548" stroke-width="1.5" />
