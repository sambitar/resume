<svg class="demo-svg demo-fm200" viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="fm200-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#141a24" />
      <stop offset="100%" stop-color="#0c0f14" />
    </linearGradient>
  </defs>
  <rect width="320" height="200" fill="url(#fm200-bg)" />
  <!-- Panel -->
  <rect x="24" y="40" width="140" height="120" rx="6" fill="#1a2230" stroke="#2a3548" stroke-width="1.5" />
  <text x="94" y="58" text-anchor="middle" fill="#9aa8bc" font-size="8" font-family="IBM Plex Mono, monospace">4-ZONE PANEL</text>
  <g class="fm200-zones">
    <rect x="36" y="68" width="26" height="18" rx="3" fill="#1a2230" stroke="#3d9eff" class="zone-led z1" />
    <rect x="68" y="68" width="26" height="18" rx="3" fill="#1a2230" stroke="#3d9eff" class="zone-led z2" />
    <rect x="100" y="68" width="26" height="18" rx="3" fill="#1a2230" stroke="#3d9eff" class="zone-led z3" />
    <rect x="132" y="68" width="26" height="18" rx="3" fill="#1a2230" stroke="#3d9eff" class="zone-led z4" />
    <text x="49" y="80" text-anchor="middle" fill="#9aa8bc" font-size="7">Z1</text>
    <text x="81" y="80" text-anchor="middle" fill="#9aa8bc" font-size="7">Z2</text>
    <text x="113" y="80" text-anchor="middle" fill="#9aa8bc" font-size="7">Z3</text>
    <text x="145" y="80" text-anchor="middle" fill="#9aa8bc" font-size="7">Z4</text>
  </g>
  <line x1="94" y1="98" x2="94" y2="118" stroke="#2a3548" stroke-width="1" />
  <rect x="56" y="118" width="76" height="14" rx="3" fill="#2563a8" opacity="0.4" stroke="#3d9eff" stroke-width="1" />
  <text x="94" y="128" text-anchor="middle" fill="#3d9eff" font-size="7" font-family="IBM Plex Mono, monospace">FM200 CTRL</text>
  <!-- Cylinder -->
  <g class="fm200-tank">
    <rect x="200" y="55" width="48" height="90" rx="6" fill="#1a2230" stroke="#2a3548" stroke-width="1.5" />
    <ellipse cx="224" cy="55" rx="24" ry="8" fill="#2a3548" />
    <text x="224" y="100" text-anchor="middle" fill="#9aa8bc" font-size="8" font-family="IBM Plex Mono, monospace">FM200</text>
    <path class="fm200-flow" d="M 176 90 L 200 90" stroke="#3d9eff" stroke-width="2" fill="none" stroke-dasharray="4 3" />
  </g>
  <circle cx="280" cy="100" r="22" fill="none" stroke="#3d9eff" stroke-width="1.5" class="fm200-status" opacity="0.6" />
  <text x="280" y="104" text-anchor="middle" fill="#3d9eff" font-size="8" font-family="IBM Plex Mono, monospace">ARM</text>
</svg>
