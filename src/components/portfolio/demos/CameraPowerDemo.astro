<svg class="demo-svg demo-camera-power" viewBox="0 0 320 200" xmlns="http://www.w3.org/2000/svg">
  <rect width="320" height="200" fill="#0c0f14" />
  <!-- Camera -->
  <g transform="translate(40, 70)">
    <rect x="0" y="20" width="70" height="44" rx="6" fill="#1a2230" stroke="#2a3548" stroke-width="1.5" />
    <circle cx="52" cy="42" r="14" fill="#141a24" stroke="#3d9eff" stroke-width="1.5" class="cam-lens" />
    <rect x="8" y="8" width="20" height="14" rx="2" fill="#2a3548" />
    <text x="35" y="78" text-anchor="middle" fill="#9aa8bc" font-size="8" font-family="IBM Plex Mono, monospace">12V AC</text>
  </g>
  <!-- AC wave -->
  <g class="pwr-wave" transform="translate(118, 88)">
    <path d="M0 20 Q10 0 20 20 T40 20 T60 20" stroke="#3d9eff" stroke-width="2" fill="none" opacity="0.8" />
    <text x="30" y="48" text-anchor="middle" fill="#9aa8bc" font-size="7" font-family="IBM Plex Mono, monospace">AC</text>
  </g>
  <!-- PSU -->
  <g transform="translate(188, 55)">
    <rect x="0" y="0" width="90" height="90" rx="6" fill="#1a2230" stroke="#3d9eff" stroke-width="1.5" class="psu-box" />
    <rect x="12" y="14" width="66" height="20" rx="3" fill="#141a24" />
    <text x="45" y="28" text-anchor="middle" fill="#3d9eff" font-size="8" font-family="IBM Plex Mono, monospace">PSU</text>
    <circle cx="24" cy="52" r="4" fill="#3d9eff" class="psu-led" />
    <circle cx="45" cy="52" r="4" fill="#2a3548" />
    <circle cx="66" cy="52" r="4" fill="#2a3548" />
    <rect x="12" y="64" width="66" height="12" rx="2" fill="#2563a8" opacity="0.5" />
    <text x="45" y="73" text-anchor="middle" fill="#e8edf5" font-size="7" font-family="IBM Plex Mono, monospace">OUTPUT OK</text>
  </g>
  <path d="M110 100 L188 100" stroke="#3d9eff" stroke-width="2" marker-end="url(#arrow)" />
  <defs>
    <marker id="arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
      <path d="M0,0 L6,3 L0,6 Z" fill="#3d9eff" />
    </marker>
  </defs>
</svg>
