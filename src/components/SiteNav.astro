---
import ProfileName from "./ProfileName.astro";

interface Props {
  active?: "skills" | "portfolio";
}

const { active } = Astro.props;

const links = [
  { href: "/", label: "Skills", id: "skills" as const },
  { href: "/portfolio", label: "Portfolio", id: "portfolio" as const },
];
---

<nav class="site-nav" aria-label="Main">
  <div class="container site-nav-inner">
    <a href="/" class="site-nav-brand">
      <ProfileName variant="nav" />
    </a>
    <ul class="site-nav-links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[{ "is-active": active === link.id }]}
            aria-current={active === link.id ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
